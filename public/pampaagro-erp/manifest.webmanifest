{
  "name": "PampaAgro ERP",
  "short_name": "PampaAgro",
  "description": "Gestion agropecuaria integral offline-first on-response",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1419",
  "theme_color": "#0f1419",
  "lang": "es-AR",
  "dir": "ltr",
  "categories": ["business", "productivity"],
  "share_target": {
    "action": "./compartir-nota-de-voz",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", ".ogg", ".opus", ".m4a", ".mp3", ".mp4", ".wav"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
