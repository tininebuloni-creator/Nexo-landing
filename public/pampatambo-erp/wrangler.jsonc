{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pampatambo-erp",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public_protected"
  }
