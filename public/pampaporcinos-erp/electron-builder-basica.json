{
  "appId": "com.pampa.porcinos.basica",
  "productName": "PampaPorcinos Basica",
  "asar": true,
  "electronDist": "node_modules/electron/dist",
  "npmRebuild": true,
  "directories": { "output": "release-basica" },
  "files": ["index.html", "*.js", "*.css", "*.png", "*.jfif", "*.xlsx", "manifest.webmanifest", "sw.js", "server.js", "electron/**/*", "services/**/*", "data/**/*", "leaflet/**/*", "package.json"],
  "extraMetadata": { "main": "electron/main.js", "porcinosPack": "basica" },
  "win": { "icon": "build/icon.ico", "target": ["nsis"], "executableName": "PampaPorcinos-Basica", "signAndEditExecutable": false },
  "nsis": { "include": "build/installer.nsh", "oneClick": false, "allowToChangeInstallationDirectory": true, "allowElevation": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "PampaPorcinos Basica", "uninstallDisplayName": "Desinstalar PampaPorcinos Basica" }
}