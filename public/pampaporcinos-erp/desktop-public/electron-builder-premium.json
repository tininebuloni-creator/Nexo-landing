{
  "appId": "com.pampa.porcinos.premium",
  "productName": "PampaPorcinos Premium",
  "asar": true,
  "electronDist": "node_modules/electron/dist",
  "npmRebuild": true,
  "directories": { "output": "release-premium" },
  "files": ["index.html", "*.js", "*.css", "*.png", "*.jfif", "*.xlsx", "manifest.webmanifest", "sw.js", "server.js", "electron/**/*", "services/**/*", "data/**/*", "leaflet/**/*", "package.json"],
  "extraMetadata": { "main": "electron/main.js", "porcinosPack": "premium" },
  "win": { "target": ["nsis"], "executableName": "PampaPorcinos-Premium", "signAndEditExecutable": false },
  "nsis": { "include": "build/installer.nsh", "oneClick": true, "allowToChangeInstallationDirectory": false, "allowElevation": false, "perMachine": false }
}