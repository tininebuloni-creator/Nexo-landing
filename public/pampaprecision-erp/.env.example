DB_HOST=localhost
DB_PORT=5432
DB_NAME=pampaprecision
DB_USER=postgres
DB_PASSWORD=your_password
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# ARCA / AFIP Web Services
ARCA_ENVIRONMENT=testing
ARCA_CUIT=20123456789
