# Entorno: homologacion por defecto; usar production para operar en vivo
NODE_ENV=development

# CUIT del productor representado, sin guiones
CUIT_PRODUCTOR=

# Servicio habilitado en ARCA/AFIP para el certificado
AFIP_SERVICE_NAME=wsigsa

# Opcional: dejar vacios los defaults para usar los WSDL oficiales por entorno
AFIP_WSAA_WSDL=
SENASA_SIGSA_WSDL=

# Reglas municipales opcionales. La clave es municipioId.
# Ejemplo: {"default":{"modalidad":"PENDIENTE","importePorCabeza":0,"requierePagoAntesDeEmitir":true}}
FISCAL_TASAS_MUNICIPALES={}

# URL pública del servidor que entrega el trial por WhatsApp.
# Ejemplo: https://trial.nexoagro.com.ar
NEXO_AGRO_TRIAL_URL=

# Rutas de los archivos entregados por ARCA
AFIP_CERT_FILE=certs/homologacion.crt
AFIP_KEY_FILE=certs/homologacion.key
